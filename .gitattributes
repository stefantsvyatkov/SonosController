# Set default behaviour, in case users don't have core.autocrlf set.
* text=auto
globalPlugins/sonosController/_vendor/** text eol=lf
experimental/ffmpeg-relay/bin/**/*.exe binary
experimental/ffmpeg-relay/bin/**/*.txt text eol=lf
experimental/ffmpeg-relay/bin/**/*.sha256 text eol=lf
experimental/ffmpeg-relay/thirdParty/ffmpeg/** text eol=lf
experimental/ffmpeg-relay/tools/*.sh text eol=lf

# Try to ensure that po files in the repo does not include
# source code line numbers.
# Every person expected to commit po files should change their personal config file as described here:
# https://mail.gnome.org/archives/kupfer-list/2010-June/msg00002.html
*.po filter=cleanpo
