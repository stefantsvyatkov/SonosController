# Build output and the pip-installed dependency staging area.
/build/
*.nvda-addon

# Local tooling that is fetched, not authored, and what the sandbox stages:
# NVDA installers, the built add-on, the portable Python and each run results.
/.tools/
/artifacts/

# Generated documentation and translation artefacts.
doc/*/readme.html
*_docHandler.py
*.mo
*.pot
/[0-9]*.[0-9]*.[0-9]*.json

# Python.
*.py[co]
__pycache__/
*.egg-info
.venv/
.ruff_cache/

# Records of the first relay study: measurements from the real speakers,
# which hold addresses from the test machine, so they stay out of Git.
/research/relay-prototype/
